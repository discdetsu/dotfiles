// ~/.config/fastfetch/config.jsonc — minimal, Everforest Dark Hard (matches Neovim, tmux, starship)
// Palette: https://github.com/sainnhe/everforest/blob/master/palette.md
//   fg #d3c6aa  grey1 #859289  red #e67e80  orange #e69875  yellow #dbbc7f
//   green #a7c080  aqua #83c092  blue #7fbbb3  purple #d699b6
// Colors are ANSI truecolor codes: "38;2;R;G;B". Icons need a Nerd Font.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "Fedora_small",
    "color": {
      "1": "38;2;167;192;128", // green
      "2": "38;2;211;198;170"  // fg
    },
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;167;192;128", // green icons
      "title": "38;2;131;192;146", // aqua
      "output": "38;2;211;198;170" // fg
    },
    "key": { "width": 3 }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{#1;38;2;131;192;146}{user-name}{#38;2;133;146;137}@{#38;2;127;187;179}{host-name}"
    },
    "break",
    { "type": "os",       "key": "", "format": "{name} {version-id}" },
    { "type": "host",     "key": "\udb80\udf22", "format": "{family}" },
    { "type": "kernel",  "key": "", "format": "{release}" },
    { "type": "uptime",   "key": "󰅐" },
    { "type": "packages", "key": "󰏖" },
    { "type": "shell",    "key": "", "format": "{pretty-name}" },
    { "type": "terminal", "key": "", "format": "{pretty-name}" },
    { "type": "wm",       "key": "", "format": "{pretty-name}" },
    { "type": "cpu",      "key": "", "format": "{name}" },
    { "type": "memory",   "key": "󰍛", "format": "{used} / {total}" },
    { "type": "disk",     "key": "󰋊", "folders": "/", "format": "{size-used} / {size-total} ({size-percentage})" },
    "break",
    {
      // Everforest accent dots instead of the terminal's 16 ANSI colors
      "type": "custom",
      "format": "{#38;2;230;126;128}● {#38;2;230;152;117}● {#38;2;219;188;127}● {#38;2;167;192;128}● {#38;2;131;192;146}● {#38;2;127;187;179}● {#38;2;214;153;182}●"
    }
  ]
}
